{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CatDesk",
  "version": "1.0.0",
  "identifier": "com.catdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CatDesk",
        "width": 520,
        "height": 380,
        "minWidth": 440,
        "minHeight": 340,
        "maxWidth": 700,
        "maxHeight": 500,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
